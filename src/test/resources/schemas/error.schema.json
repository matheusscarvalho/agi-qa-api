{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "status", "code"],
  "properties": {
    "status": { "type": "string", "enum": ["error"] },
    "message": { "type": "string", "minLength": 1 },
    "code": { "type": "integer", "enum": [404] }
  }
}
