{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "status"],
  "properties": {
    "status": { "type": "string", "enum": ["success"] },
    "message": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z]+$" }
    }
  }
}
